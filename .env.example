# Get a free API key at https://www.themoviedb.org/settings/api
# (You can also skip this and paste the key into the app's Settings page instead.)
TMDB_API_KEY=

# The PC hosting your movie shares. Use its IP address, not its hostname —
# the Linux VM Docker Desktop runs in often can't resolve Windows NetBIOS
# hostnames the way Windows itself does.
SMB_HOST=192.168.1.X

# Credentials for the SMB share(s). If the share allows guest/anonymous
# access instead, set SMB_USER=guest and delete the password= part of the
# "o:" option in docker-compose.yml's volume definitions.
SMB_USER=
SMB_PASS=

# Sub-path of each share, relative to //SMB_HOST/ — e.g. if you browse to
# \\SMB_HOST\movies\Movies in Explorer, this is "movies/Movies". These stay
# out of docker-compose.yml on purpose so your folder names/layout aren't in
# a file you might publish or share publicly.
SMB_SHARE1=movies/share-one
SMB_SHARE2=movies/share-two
SMB_SHARE3=movies/share-three

# Same idea for the audiobook library — same SMB_HOST/USER/PASS above, just
# a different sub-path (this doesn't have to be a different share, just a
# different folder on it).
SMB_SHARE_AUDIOBOOKS=movies/Audiobooks

# Same idea again for the ebook library — same share, different sub-path.
SMB_SHARE_EBOOKS=movies/Ebooks

# Same idea again for the music library — same share, different sub-path.
SMB_SHARE_ALBUMS=movies/Music

# Same idea again for the TV library — same share, different sub-path.
SMB_SHARE_TV=movies/TV

# Local path (on THIS Docker host, not a network share) where you keep a
# synced copy of your LaunchBox installation's Data/ and Images/ folders —
# see "Games" in the README. LaunchBox usually runs on a different PC, so
# this expects you to sync those two folders here yourself (robocopy/rsync/
# Syncthing/etc. on a schedule), rather than mounting the other PC's share
# live the way the SMB_SHARE_* variables above do.
LAUNCHBOX_SYNC_PATH=C:\LaunchBoxSync

# Where scheduled/manual database backups (see "Backups" in the README)
# actually get written on the Docker host. Point this at somewhere
# genuinely independent of wherever ./data (this stack's own database
# folder) lives — a different disk, a different share, anywhere that
# wouldn't be reset by the same event that could wipe ./data. Leaving this
# unset falls back to a ./backups folder next to ./data, which is better
# than nothing but doesn't protect against that specific scenario.
BACKUP_SYNC_PATH=C:\MediaCatalogBackups
