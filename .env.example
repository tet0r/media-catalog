# Get a free API key at https://www.themoviedb.org/settings/api
# (You can also skip this and paste the key into the app's Settings page instead.)
TMDB_API_KEY=

# Local folders on this machine for each media type. Only fill in the ones
# you're using — leave the rest as the defaults (an empty ./folder next to
# docker-compose.yml) and that media type just stays empty until you do.
MOVIES_PATH=/path/to/your/movies
AUDIOBOOKS_PATH=/path/to/your/audiobooks
COMICS_PATH=/path/to/your/comics
EBOOKS_PATH=/path/to/your/ebooks
ALBUMS_PATH=/path/to/your/music
TV_PATH=/path/to/your/tv

# Local path where you keep a synced copy of your LaunchBox installation's
# Data/ and Images/ folders — see "Games" in the README. LaunchBox usually
# runs on a different PC, so this expects you to sync those two folders
# here yourself (robocopy/rsync/Syncthing/etc.), rather than mounting the
# other PC's share live.
LAUNCHBOX_SYNC_PATH=/path/to/LaunchBoxSync

# Where scheduled/manual database backups (see "Backups" in the README)
# land. Point this somewhere genuinely independent of ./data (this stack's
# own database folder) if you want backups to survive that folder being
# reset — a different disk, a different share. Leaving this unset falls
# back to a ./backups folder next to ./data, which is better than nothing
# but doesn't protect against that specific scenario.
BACKUP_SYNC_PATH=/path/to/MediaCatalogBackups

# --- Only needed if your media library lives on a DIFFERENT machine than
# --- this one (a NAS, another PC) and you're using
# --- docker-compose.network-shares.yml instead of docker-compose.yml —
# --- see "Network shares" in the README.
# SMB_HOST=192.168.1.X
# SMB_USER=
# SMB_PASS=
# SMB_SHARE1=movies/share-one
# SMB_SHARE2=movies/share-two
# SMB_SHARE3=movies/share-three
# SMB_SHARE_AUDIOBOOKS=movies/Audiobooks
# SMB_SHARE_COMICS=movies/Audiobooks/Comics
# SMB_SHARE_EBOOKS=movies/Ebooks
# SMB_SHARE_ALBUMS=movies/Music
# SMB_SHARE_TV=movies/TV
